{
  "name": "lunaris",
  "version": "2.3.2",
  "description": "Lunaris — Tarot, Astroloji & ML Tabanlı Kozmik Portal",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "stamp": "node scripts/stamp-version.js",
    "build": "node scripts/stamp-version.js && node copy-web.js",
    "build:apk": "node scripts/build-apk.js",
    "sync": "npm run build && npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "open:android": "npm run build && npx cap open android",
    "open:ios": "npm run build && npx cap open ios",
    "run:android": "npm run build && npx cap run android",
    "run:ios": "npm run build && npx cap run ios",
    "test:personal": "node scripts/test-personal.js",
    "test:personal:browser": "node scripts/test-personal-browser.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-lunaris \"node scripts/test-firestore-rules.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkelmali/Lunaris.git"
  },
  "keywords": [
    "astrology",
    "tarot",
    "machine-learning",
    "horoscope",
    "capacitor",
    "android",
    "ios"
  ],
  "author": "Berk Elmalı",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "sharp": "^0.35.4"
  }
}
