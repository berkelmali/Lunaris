{
  "hosting": {
    "site": "lunaris",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "android/**",
      "ios/**",
      "www/**",
      "scripts/**",
      "copy-web.js",
      "package.json",
      "package-lock.json",
      "capacitor.config.json",
      "OKU-BENI.txt",
      "BIRLESTIRME.md",
      "generate-assets.js"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "ml-weights.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "vendor/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
