<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme — dark, no flash -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#0B0714</item>
        <item name="colorPrimaryDark">#0B0714</item>
        <item name="colorAccent">#D4AF6A</item>
        <item name="android:windowBackground">#0B0714</item>
        <item name="android:statusBarColor">#0B0714</item>
        <item name="android:navigationBarColor">#0B0714</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#0B0714</item>
        <item name="android:statusBarColor">#0B0714</item>
        <item name="android:navigationBarColor">#0B0714</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">#0B0714</item>
        <item name="android:navigationBarColor">#0B0714</item>
    </style>

</resources>