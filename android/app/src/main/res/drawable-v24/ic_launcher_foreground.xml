<?xml version="1.0" encoding="utf-8"?>
<!--
    Lunaris App Icon — Adaptive Foreground Layer
    108dp canvas (safe zone: 72dp centered)
    Design: crescent moon (amethyst) + gold orbital rings + gold star + white sparkle
    Note: Uses solid colors only (no aapt gradient) for broadest compatibility
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer orbital ring -->
    <path
        android:pathData="M54,17 A37,37 0 0,1 91,54 A37,37 0 0,1 54,91 A37,37 0 0,1 17,54 A37,37 0 0,1 54,17 Z"
        android:strokeWidth="0.9"
        android:strokeColor="#99D4AF6A"
        android:fillColor="#00000000"/>

    <!-- Inner orbital ring -->
    <path
        android:pathData="M54,23 A31,31 0 0,1 85,54 A31,31 0 0,1 54,85 A31,31 0 0,1 23,54 A31,31 0 0,1 54,23 Z"
        android:strokeWidth="0.6"
        android:strokeColor="#55D4AF6A"
        android:fillColor="#00000000"/>

    <!-- Diagonal elliptical orbit arc -->
    <path
        android:pathData="M28,40 Q54,25 80,68"
        android:strokeWidth="0.7"
        android:strokeColor="#44D4AF6A"
        android:fillColor="#00000000"
        android:strokeLineCap="round"/>

    <!-- Crescent Moon — full circle (amethyst/rose blend: use midpoint #A8638A) -->
    <path
        android:pathData="M54,27 A27,27 0 1,1 53.99,27 Z"
        android:fillColor="#A8638A"/>

    <!-- Crescent inner cutout — slightly offset to create crescent shape -->
    <path
        android:pathData="M60,31 A21,21 0 1,1 59.99,31 Z"
        android:fillColor="#0B0714"/>

    <!-- Soft glow behind star (subtle circle) -->
    <path
        android:pathData="M37,34 A6,6 0 1,1 36.99,34 Z"
        android:fillColor="#22F0C674"/>

    <!-- Five-pointed Gold Star -->
    <path
        android:pathData="M37,27.5 L38.8,33.2 L44.8,33.2 L40,36.8 L41.8,42.5 L37,38.9 L32.2,42.5 L34,36.8 L29.2,33.2 L35.2,33.2 Z"
        android:fillColor="#F0C674"/>

    <!-- White sparkle dot (lower right of moon) -->
    <path
        android:pathData="M69,66 A2,2 0 1,1 68.99,66 Z"
        android:fillColor="#DDFFFFFF"/>

    <!-- Sparkle cross lines -->
    <path
        android:pathData="M69,63 L69,69"
        android:strokeWidth="0.6"
        android:strokeColor="#66FFFFFF"
        android:fillColor="#00000000"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M66,66 L72,66"
        android:strokeWidth="0.6"
        android:strokeColor="#66FFFFFF"
        android:fillColor="#00000000"
        android:strokeLineCap="round"/>

</vector>
