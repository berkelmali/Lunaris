rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Topluluk Duvarı (Twitter/Feed akışı - Herkes okuyabilir ve giriş yapan herkes post atabilir)
    match /wallPosts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.text is string && request.resource.data.text.size() > 0;
      allow update: if true;
      allow delete: if request.auth != null;
    }
    
    // Kozmik Dilek Galaksisi
    match /wishes/{wishId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }
    
    // Kullanıcı Profilleri & Tercihler
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
      
      match /readings/{readingId} {
        allow read, write: if true;
      }
      match /horoscopes/{horoId} {
        allow read, write: if true;
      }
    }
    
    // Varsayılan
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
