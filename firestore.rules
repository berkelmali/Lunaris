rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yardımcı Doğrulama Fonksiyonları
    function isAuthenticated() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSessionParticipant(sessionData) {
      return isAuthenticated() && 
        (request.auth.uid == sessionData.initiatorUid || request.auth.uid == sessionData.recipientUid);
    }

    // 1. Kullanıcı Profilleri & Kişisel Veriler
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /readings/{readingId} {
        allow read, write: if isOwner(userId);
      }
      match /horoscopes/{horoId} {
        allow read, write: if isOwner(userId);
      }
      match /cosmic_journal/{entryId} {
        allow read, write: if isOwner(userId);
      }
      match /ml_intelligence/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /fcm_tokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
      match /cooldowns/{cooldownId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Co-Op Tarot Seansları (100% Free / Sunucusuz Mimari)
    match /coop_sessions/{sessionId} {
      allow read: if isSessionParticipant(resource.data);

      allow create: if isAuthenticated() 
        && request.resource.data.initiatorUid == request.auth.uid
        && request.resource.data.status == "PENDING_RECIPIENT"
        && request.resource.data.initiatorHasDrawn == false
        && request.resource.data.recipientHasDrawn == false
        && request.resource.data.expiresAt > request.time;

      allow update: if isSessionParticipant(resource.data)
        && request.resource.data.initiatorUid == resource.data.initiatorUid
        && request.resource.data.recipientUid == resource.data.recipientUid;

      allow delete: if false;

      // Özel Çekimler Alt Koleksiyonu:
      // Kullanıcı B ancak KENDİSİ DE kart çektikten sonra Kullanıcı A'nın kartını okuyabilir (Anti-Cheat)
      match /draws/{userId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/coop_sessions/$(sessionId)).data.recipientHasDrawn == true
        );
        allow create: if isAuthenticated() 
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.card.cardId >= 0 
          && request.resource.data.card.cardId <= 21;
        allow update, delete: if false;
      }
    }

    // 3. Bildirimler Koleksiyonu (In-App Bildirim Çanı & Sosyal Tetikleyiciler)
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.recipientUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.recipientUid is string;
    }

    // 4. Günlük Tarot Çekimleri (Senkron Eko Tespiti İçin)
    match /tarot_pulls/{pullId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // 5. Arkadaşlık / Sosyal Bağlantılar
    match /connections/{connectionId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.participants;
    }

    // 6. Arcana Eko Eşleşme Kilidi (İstemci Tarafı Kontroller İçin)
    match /arcana_echo_cooldowns/{pairKey} {
      allow read, write: if isAuthenticated();
    }

    // 7. Topluluk Duvarı
    match /wallPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthenticated()
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                        || yorumEkleme());

      function yorumEkleme() {
        let eski = resource.data.get('comments', []);
        let yeni = request.resource.data.comments;
        let c = yeni[eski.size()];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
          && yeni is list
          && yeni.size() == eski.size() + 1
          && yeni.size() <= 200
          && (eski.size() == 0 || yeni[0:eski.size()] == eski)
          && c is map
          && c.keys().hasOnly(['id', 'name', 'text', 'photoURL', 'createdAt', 'authorUid'])
          && c.keys().hasAll(['id', 'name', 'text', 'createdAt', 'authorUid'])
          && c.authorUid == request.auth.uid
          && c.id is string && c.id.size() <= 64
          && c.name is string && c.name.size() <= 60
          && c.text is string && c.text.size() > 0 && c.text.size() <= 280
          && c.createdAt is string && c.createdAt.size() <= 40
          && (!('photoURL' in c) || c.photoURL == null
              || (c.photoURL is string && c.photoURL.size() <= 500 && c.photoURL.matches('https://.*')));
      }
      allow delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || resource.data.authorUid == "user_" + request.auth.uid);
    }

    // 8. Kozmik Dilek Galaksisi
    match /constellationWishes/{wishId} {
      allow read: if true;
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 280
                    && (!isAuthenticated() || request.resource.data.authorUid == request.auth.uid);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lightCount']);
      allow delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }

    // 9. ML Geri Bildirim Koleksiyonu
    match /ml_feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasAll(['signKey', 'category', 'rating', 'score', 'signVector', 'temporalVector'])
                    && request.resource.data.rating is int
                    && (request.resource.data.rating == 0 || request.resource.data.rating == 1)
                    && request.resource.data.signKey is string
                    && request.resource.data.category is string
                    && request.resource.data.signVector is list
                    && request.resource.data.temporalVector is list
                    && request.resource.data.signVector.size() == 8
                    && request.resource.data.temporalVector.size() == 8;
      allow read, update, delete: if false;
    }

    // 10. Varsayılan Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
