rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yardımcı Doğrulama Fonksiyonları
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Kullanıcı Profilleri & Kişisel Fallar
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      match /readings/{readingId} {
        allow read, write: if isOwner(userId);
      }
      match /horoscopes/{horoId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Topluluk Duvarı
    match /wallPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.authorUid == request.auth.uid;
      // Güncellemede yalnızca iki şeye izin var: beğeni sayısı ya da TEK bir
      // yorum eklemek. Metin, yazar ve mevcut yorumlar değiştirilemez.
      // (Eskiden "allow update: if isAuthenticated()" idi — giriş yapan HERKES
      // başkasının gönderisinin metnini ve yazar kimliğini değiştirebiliyordu.)
      allow update: if isAuthenticated()
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                        || yorumEkleme());

      // Yorumlar gönderinin 'comments' dizisinde tutuluyor; böylece duvarın
      // mevcut canlı dinleyicisi onları ek bir sorgu olmadan taşıyor.
      // Bu kural diziyi yalnızca-ekleme (append-only) yapıyor:
      //  - dizi tam olarak bir eleman büyümeli
      //  - mevcut elemanlar birebir aynı kalmalı (silme/düzenleme yok)
      //  - yeni yorumun yazarı isteği yapan kullanıcı olmalı
      //  - alanlar ve uzunluklar sınırlı; görsel yalnızca https
      function yorumEkleme() {
        let eski = resource.data.get('comments', []);
        let yeni = request.resource.data.comments;
        let c = yeni[eski.size()];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
          && yeni is list
          && yeni.size() == eski.size() + 1
          && yeni.size() <= 200
          // Boş aralık dilimi (yeni[0:0]) kurallarda değerlendirme hatası
          // veriyor; önceki yorum yoksa korunacak bir şey de yok.
          && (eski.size() == 0 || yeni[0:eski.size()] == eski)
          && c is map
          && c.keys().hasOnly(['id', 'name', 'text', 'photoURL', 'createdAt', 'authorUid'])
          && c.keys().hasAll(['id', 'name', 'text', 'createdAt', 'authorUid'])
          && c.authorUid == request.auth.uid
          && c.id is string && c.id.size() <= 64
          && c.name is string && c.name.size() <= 60
          && c.text is string && c.text.size() > 0 && c.text.size() <= 280
          && c.createdAt is string && c.createdAt.size() <= 40
          && (!('photoURL' in c) || c.photoURL == null
              || (c.photoURL is string && c.photoURL.size() <= 500 && c.photoURL.matches('https://.*')));
      }
      allow delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || resource.data.authorUid == "user_" + request.auth.uid);
    }

    // 3. Kozmik Dilek Galaksisi
    // Koleksiyon adı istemcide 'wishes' -> 'constellationWishes' olarak
    // değişmişti ama kural adı eski kalmıştı. Tanımsız koleksiyon en alttaki
    // catch-all 'if false' kuralına düşüyor; bu yüzden dilek galaksisi canlıda
    // permission-denied alıp sessizce localStorage'a düşüyordu — kullanıcılar
    // birbirinin dileklerini hiç görmüyordu.
    match /constellationWishes/{wishId} {
      allow read: if true;
      // Misafirler de dilek bırakabilir (ürün tasarımı böyle), ama giriş
      // yapmış bir kullanıcı başkasının kimliğiyle yazamaz.
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 280
                    && (!isAuthenticated() || request.resource.data.authorUid == request.auth.uid);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lightCount']);
      allow delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }

    // 4. ML Geri Bildirim Koleksiyonu (Sıkı Şema Doğrulaması)
    match /ml_feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasAll(['signKey', 'category', 'rating', 'score', 'signVector', 'temporalVector'])
                    && request.resource.data.rating is int
                    && (request.resource.data.rating == 0 || request.resource.data.rating == 1)
                    && request.resource.data.signKey is string
                    && request.resource.data.category is string
                    && request.resource.data.signVector is list
                    && request.resource.data.temporalVector is list
                    && request.resource.data.signVector.size() == 8
                    && request.resource.data.temporalVector.size() == 8;
      allow read, update, delete: if false;
    }

    // 5. Varsayılan: Tanımlanmamış tüm yollara erişimi tamamen engelle
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
